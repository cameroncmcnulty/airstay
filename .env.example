# Duffel (Stays + Flights). Create a test token at https://app.duffel.com
# Request Duffel Stays access, then Developers → Access tokens.
# Add the same value in Vercel → Settings → Environment Variables.
DUFFEL_ACCESS_TOKEN=

# Travelpayouts Data API for affiliate flight checkout URLs (marker 564250).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=564250

# Admin dashboard at /admin
ADMIN_PASSWORD=
